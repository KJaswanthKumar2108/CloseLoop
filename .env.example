# ==============================================================================
# CloseLoop — Environment Configuration Reference
# ==============================================================================
# For local development: Set these variables in .env.local
# For Vercel / Netlify / Cloud Deployments:
# Configure these in your platform's Project Settings -> Environment Variables.
# IMPORTANT: Never commit .env.local or expose production secrets in git.
# ==============================================================================

# ------------------------------------------------------------------------------
# PayPal Developer Platform (Sandbox Mode Only)
# Obtain Sandbox credentials from:
# https://developer.paypal.com/dashboard/applications/sandbox
# ------------------------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Authoritative Merchant Context (Single-Tenant Identity)
# Required to prevent tenant spoofing.
# ------------------------------------------------------------------------------
CLOSELOOP_MERCHANT_ID=default_merchant_sandbox

# ------------------------------------------------------------------------------
# Google Gemini AI Foundation Model
# Obtain API key from Google AI Studio (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# PostgreSQL Database Persistence & Role Separation
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/closeloop
DATABASE_READER_URL=postgresql://closeloop_investigation_reader:ReaderPass_184_Secure!@localhost:5432/closeloop
DATABASE_AUDITOR_URL=postgresql://closeloop_investigation_auditor:AuditorPass_184_Secure!@localhost:5432/closeloop

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
