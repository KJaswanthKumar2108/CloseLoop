# ==============================================================================
# CloseLoop — Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env.local or expose sensitive secrets in client code.
# ==============================================================================

# ------------------------------------------------------------------------------
# PayPal Developer Platform (Sandbox Mode Only)
# Obtain Sandbox credentials from:
# https://developer.paypal.com/dashboard/applications/sandbox
# ------------------------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=   

# ------------------------------------------------------------------------------
# Google Gemini AI Foundation Model (Phase 4)
# Obtain API key from Google AI Studio (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# PostgreSQL Database Persistence (Phase 3C.1)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL database.
# In development/test environments without a live PostgreSQL instance,
# in-memory harnesses are used during hermetic testing.
# When running with a local PostgreSQL server (e.g., PostgreSQL 18):
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/closeloop

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
